# Copy this file to .env and fill in real values. Never commit the real .env file.

# Security
SECRET_KEY=i-like-to-eat-pizza-and-drink-coffee-with-sugar-in-my-coffee
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default - zero setup, file lives in backend/data/app.db)
# To use PostgreSQL later, set DATABASE_URL to e.g.
# postgresql+psycopg2://user:password@localhost:5432/break_the_loop
DATABASE_URL=sqlite:///./data/app.db

# Groq (LLM layer) - get a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Minimum number of labeled events required before the ML model
# (logistic regression) is trained/used instead of the rule-based engine
ML_MIN_TRAINING_EVENTS=30
